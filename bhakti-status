      canvas.toBlob(blob => {
        const link = document.createElement('a');
        link.download = `apna-bhakti-status.png`;
        link.href = URL.createObjectURL(blob);
        link.click();
        showToast('📥 आपका कस्टमाइज़ स्टेटस डाउनलोड हो गया!');
      }, 'image/png');
    }

    function shareCustomStatusToWhatsApp() {
      const canvas = document.getElementById('customStatusCanvas');
      if (!canvas) return;
      const dateInfo = getFormattedHindiDate(activeDate);
      const greeting = document.getElementById('creatorDeitySelect').value;
      const suvichar = document.getElementById('creatorSuvicharText').value;
      const sender = document.getElementById('creatorSenderName').value;
      const shareText = `🚩 ${greeting} 🚩\n\n"${suvichar}"\n\n📅 ${dateInfo.fullText}\n${sender}\n\nभक्ति स्टेटस ऐप से बनाया गया`;

      canvas.toBlob(blob => {
        const file = new File([blob], 'my_bhakti_status.png', { type: 'image/png' });
        if (navigator.canShare && navigator.canShare({ files: [file] })) {
          navigator.share({ title: greeting, text: shareText, files: [file] }).catch(console.error);
        } else {
          window.open(`https://api.whatsapp.com/send?text=${encodeURIComponent(shareText)}`, '_blank');
          showToast('📲 व्हाट्सएप पर शेयर करें!');
        }
      });
    }

    let toastTimer;
    function showToast(msg, icon = '✨') {
      const toast = document.getElementById('toastNotification');
      if (!toast) return;
      clearTimeout(toastTimer);
      document.getElementById('toastMessage').innerText = msg;
      document.getElementById('toastIcon').innerText = icon;
      toast.classList.remove('opacity-0', 'pointer-events-none');
      toast.classList.add('opacity-100');
      toastTimer = setTimeout(() => {
        toast.classList.remove('opacity-100');
        toast.classList.add('opacity-0', 'pointer-events-none');
      }, 2600);
    }
  </script>
</body>
</html>
