      const hour = new Date().getHours();
      let greeting = '॥ शुभ प्रभात ॥';
      if (hour >= 12 && hour < 17) greeting = '॥ शुभ दोपहर ॥';
      else if (hour >= 17 && hour < 21) greeting = '॥ शुभ संध्या ॥';
      else if (hour >= 21 || hour < 4) greeting = '॥ शुभ रात्रि ॥';

      document.getElementById('heroGreetingText').innerText = greeting;
      lucide.createIcons();
    }

    function playTempleBell() {
      showToast('🪔 ॐ शांति! पावन मंदिर घंटी');
      try {
        const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        osc.type = 'sine';
        osc.frequency.setValueAtTime(850, audioCtx.currentTime);
        osc.frequency.exponentialRampToValueAtTime(320, audioCtx.currentTime + 1.6);
        gain.gain.setValueAtTime(0.7, audioCtx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 1.8);
        osc.connect(gain);
        gain.connect(audioCtx.destination);
        osc.start();
        osc.stop(audioCtx.currentTime + 1.8);
      } catch (e) {
        console.warn('Audio not available:', e);
      }
