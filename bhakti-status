      const yearNum = dateObj.getFullYear();
      return {
        fullText: `${dayName}, ${dayNum} ${monthName} ${yearNum}`,
        dayName: dayName,
        dayNum: dayNum,
        monthYear: `${monthName} ${yearNum}`,
        shortText: `${dayNum} ${monthName}`
      };
