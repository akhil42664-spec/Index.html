<!DOCTYPE html>
<html lang="hi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>Bhakti Status – शुभ प्रभात | भक्ति स्टेटस</title>
  
  <!-- Meta tags for Android & PWA -->
  <meta name="theme-color" content="#9a3412" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="description" content="दैनिक हिंदू भगवान व देवी-देवताओं के शुभ प्रभात फोटो स्टेटस, सुविचार, और अपनी फोटो से स्टेटस बनाएं।" />

  <!-- Tailwind CSS & Lucide Icons -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/lucide@latest"></script>

  <!-- Google Fonts: Sacred Hindi Typography -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Rozha+One&family=Yatra+One&family=Noto+Serif+Devanagari:wght@400;600;700;900&family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            saffron: {
              50: '#fff7ed',
              100: '#ffedd5',
              200: '#fed7aa',
              500: '#f97316',
              600: '#ea580c',
              700: '#c2410c',
              800: '#9a3412',
              900: '#7c2d12',
            }
          },
          fontFamily: {
            hindi: ['"Noto Serif Devanagari"', 'serif'],
            yatra: ['"Yatra One"', 'cursive'],
            rozha: ['"Rozha One"', 'serif'],
            sans: ['Poppins', 'sans-serif'],
          }
        }
      }
    }
  </script>

  <style>
    body {
      -webkit-tap-highlight-color: transparent;
      user-select: none;
      font-family: 'Poppins', 'Noto Serif Devanagari', sans-serif;
    }
    .custom-scrollbar::-webkit-scrollbar {
      display: none;
    }
    .custom-scrollbar {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }
    .gold-glow {
      text-shadow: 0 0 12px rgba(245, 158, 11, 0.7), 0 0 24px rgba(234, 88, 12, 0.5);
    }
    .card-shadow {
      box-shadow: 0 10px 25px -5px rgba(124, 45, 18, 0.25), 0 8px 10px -6px rgba(124, 45, 18, 0.2);
    }
  </style>
</head>
<body class="bg-amber-50/50 text-stone-900 pb-24 min-h-screen font-hindi">

  <!-- ================= TOP SACRED HEADER ================= -->
  <header class="sticky top-0 z-40 bg-gradient-to-r from-saffron-800 via-saffron-700 to-amber-700 text-white shadow-lg border-b border-amber-500/30">
    <div class="max-w-4xl mx-auto px-4 py-3 flex items-center justify-between">
      <div class="flex items-center space-x-2.5">
        <div class="w-10 h-10 rounded-full bg-amber-400/20 border border-amber-300 flex items-center justify-center text-xl shadow-inner cursor-pointer" onclick="playTempleBell()" title="आरती घंटी">
          🪔
        </div>
        <div>
          <h1 class="text-lg font-bold tracking-wide flex items-center gap-1.5 leading-tight">
            भक्ति स्टेटस <span class="text-[10px] bg-amber-400 text-saffron-950 font-bold px-1.5 py-0.5 rounded-full uppercase">शुभ प्रभात</span>
          </h1>
          <p class="text-[11px] text-amber-200 flex items-center gap-1" id="headerDateDisplay">
            <i data-lucide="calendar" class="w-3 h-3"></i> लोड हो रहा है...
          </p>
        </div>
      </div>

      <!-- Quick Action Buttons -->
      <div class="flex items-center space-x-2">
        <button onclick="playTempleBell()" title="आरती घंटी बजाएं" class="p-2 rounded-xl bg-white/10 hover:bg-white/20 active:scale-95 transition text-amber-200">
          <i data-lucide="bell" class="w-5 h-5"></i>
        </button>
        <button onclick="openDatePickerModal()" title="तिथि बदलें" class="px-2.5 py-1.5 rounded-xl bg-amber-500 text-saffron-950 font-semibold shadow hover:bg-amber-400 active:scale-95 transition text-xs flex items-center gap-1">
          <i data-lucide="calendar-days" class="w-4 h-4"></i>
          <span>तिथि</span>
        </button>
      </div>
    </div>

    <!-- Sacred Vedic Ribbon -->
    <div class="bg-saffron-950/80 px-4 py-1 text-[11px] text-amber-200/90 border-t border-amber-500/20">
      <div class="max-w-4xl mx-auto flex items-center justify-between">
        <span class="flex items-center gap-1 truncate">
          🚩 <span id="vedicDayGreeting">॥ शुभ प्रभात ॥ आपका दिन मंगलमय व सुखद हो</span>
        </span>
        <span class="text-amber-300 font-semibold cursor-pointer hover:underline text-[11px]" onclick="switchView('festivals')">
          त्योहार कैलेंडर ❯
        </span>
      </div>
    </div>
  </header>

  <!-- ================= MAIN CONTAINER ================= -->
  <main class="max-w-4xl mx-auto px-3.5 pt-3.5">

    <!-- SEARCH BAR & QUICK FILTERS -->
    <div class="mb-3 space-y-2">
      <div class="relative">
        <i data-lucide="search" class="absolute left-3.5 top-3 w-4 h-4 text-stone-400"></i>
        <input 
          type="text" 
          id="searchInput" 
          oninput="handleSearch(this.value)" 
          placeholder="भगवान, मंत्र या सुविचार खोजें (उदा. शिव, राधे, राम, हनुमान)..." 
          class="w-full pl-10 pr-10 py-2.5 bg-white rounded-2xl border border-amber-200/90 shadow-sm text-sm focus:outline-none focus:ring-2 focus:ring-saffron-500 text-stone-800"
        />
        <button id="clearSearchBtn" onclick="clearSearch()" class="hidden absolute right-3 top-2.5 text-stone-400 hover:text-stone-600">
          <i data-lucide="x" class="w-4 h-4"></i>
        </button>
      </div>

      <!-- Quick Deity Filters -->
      <div class="flex items-center gap-2 overflow-x-auto py-1 custom-scrollbar" id="categoryBubbleContainer">
        <!-- Rendered by JS -->
      </div>
    </div>

    <!-- VIEW 1: HOME FEED -->
    <section id="view-home" class="space-y-4">
      
      <!-- HERO DAILY BANNER -->
      <div class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-saffron-900 via-saffron-800 to-amber-950 text-white p-5 card-shadow border border-amber-400/30">
        <div class="absolute -right-6 -bottom-8 opacity-10 text-9xl font-serif select-none pointer-events-none">ॐ</div>
        <div class="relative z-10 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
          <div>
            <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-amber-400/20 border border-amber-300/40 text-amber-200 text-[11px] mb-2">
              <span>🪷 दैनिक मंगल विचार</span>
            </div>
            <h2 class="text-2xl sm:text-3xl font-bold font-yatra tracking-wide text-amber-100 gold-glow" id="heroGreetingText">
              शुभ प्रभात
            </h2>
            <p class="text-xs sm:text-sm text-amber-200/90 mt-1 leading-relaxed max-w-md" id="heroSuvicharText">
              "कर्म का फल व्यक्ति को उसी तरह ढूंढ लेता है, जैसे बछड़ा सैकड़ों गायों के बीच अपनी मां को। ईश्वर पर विश्वास रखें, सब शुभ होगा।"
            </p>
            <div class="mt-4 flex items-center gap-2">
              <button onclick="switchView('create')" class="px-3.5 py-2 rounded-xl bg-amber-400 hover:bg-amber-300 text-saffron-950 text-xs font-bold shadow-md active:scale-95 transition flex items-center gap-1.5">
                <i data-lucide="image-plus" class="w-3.5 h-3.5"></i>
                <span>अपनी फोटो से स्टेटस बनाएं</span>
              </button>
              <button onclick="scrollToGrid()" class="px-3 py-2 rounded-xl bg-white/10 hover:bg-white/20 text-amber-200 text-xs font-medium active:scale-95 transition flex items-center gap-1">
                <span>दर्शन करें</span>
                <i data-lucide="chevron-down" class="w-3.5 h-3.5"></i>
              </button>
            </div>
          </div>

          <!-- Dynamic Indian Date Card -->
          <div class="self-start sm:self-center bg-amber-950/80 border border-amber-400/40 rounded-2xl p-3 text-center min-w-[85px] shadow-inner shrink-0">
            <span class="block text-[11px] text-amber-300 font-semibold" id="heroDayName">गुरुवार</span>
            <span class="block text-2xl font-bold text-white font-yatra my-0.5" id="heroDayNumber">22</span>
            <span class="block text-[11px] text-amber-200/90" id="heroMonthYear">अक्टूबर</span>
          </div>
        </div>
      </div>

      <!-- MAIN STATUS GRID -->
      <div id="statusGridAnchor">
        <div class="flex items-center justify-between mb-3">
          <h3 class="text-sm sm:text-base font-bold text-stone-900 flex items-center gap-2">
            <span>🚩</span> दैनिक भक्ति स्टेटस संग्रह
          </h3>
          <span class="text-xs text-stone-500 font-sans" id="statusCountDisplay">दिखाए जा रहे हैं</span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4" id="statusCardsGrid">
          <!-- Populated by JS -->
        </div>
      </div>
    </section>

    <!-- VIEW 2: ALL CATEGORIES -->
    <section id="view-categories" class="hidden space-y-4">
      <div class="bg-gradient-to-r from-amber-700 to-saffron-700 text-white rounded-3xl p-4 shadow">
        <h2 class="text-lg font-bold flex items-center gap-2">
          <span>🗂️</span> समस्त देव श्रेणियां
        </h2>
        <p class="text-xs text-amber-100 mt-1">अपने आराध्य प्रभु अथवा देवी के पावन स्टेटस तुरंत प्राप्त करें</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3" id="allCategoriesGrid">
        <!-- Rendered by JS -->
      </div>
    </section>

    <!-- VIEW 3: CREATE OWN STATUS (अपनी फोटो जोड़ें) -->
    <section id="view-create" class="hidden space-y-4">
      <div class="bg-gradient-to-r from-saffron-800 via-amber-700 to-saffron-900 text-white rounded-3xl p-4 shadow">
        <h2 class="text-lg font-bold flex items-center gap-2">
          <span>🎨</span> अपनी फोटो से स्टेटस बनाएं
        </h2>
        <p class="text-xs text-amber-200 mt-0.5">फोन गैलरी से फोटो लगाएं या मंदिर बैकग्राउंड चुनकर नाम व सुविचार जोड़ें</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-12 gap-5">
        <!-- Canvas Preview -->
        <div class="md:col-span-6 flex flex-col items-center">
          <div class="w-full max-w-[340px] aspect-[4/5] bg-stone-900 rounded-3xl overflow-hidden shadow-xl border-2 border-amber-300/40 relative">
            <canvas id="customStatusCanvas" width="1080" height="1350" class="w-full h-full object-contain"></canvas>
            <div id="canvasPlaceholderOverlay" class="absolute inset-0 flex flex-col items-center justify-center bg-stone-900/85 text-amber-100 p-4 text-center">
              <i data-lucide="image-plus" class="w-12 h-12 text-amber-400 mb-2"></i>
              <p class="font-semibold text-sm">गैलरी से फोटो चुनें या दिव्य बैकग्राउंड लोड करें</p>
              <p class="text-[11px] text-stone-300 mt-1">आपका नाम और आज की तारीख अपने आप जुड़ जाएगी</p>
            </div>
          </div>
          <p class="text-[11px] text-stone-500 text-center mt-2">1080x1350 HD रिज़ॉल्यूशन • व्हाट्सएप स्टेटस व इंस्टाग्राम के लिए उपयुक्त</p>
        </div>

        <!-- Customizer Controls -->
        <div class="md:col-span-6 bg-white rounded-3xl p-4 border border-amber-200/90 shadow-sm space-y-3">
          
          <div class="grid grid-cols-2 gap-2">
            <label class="flex items-center justify-center gap-1.5 px-3 py-2.5 rounded-xl bg-saffron-700 hover:bg-saffron-800 text-white text-xs font-semibold cursor-pointer shadow active:scale-95 transition">
              <i data-lucide="upload" class="w-4 h-4"></i>
              <span>फोटो चुनें (गैलरी)</span>
              <input type="file" id="userPhotoInput" accept="image/*" class="hidden" onchange="handleUserPhotoUpload(event)" />
            </label>

            <button onclick="loadSampleCreatorImage()" class="flex items-center justify-center gap-1.5 px-3 py-2.5 rounded-xl bg-amber-100 hover:bg-amber-200 text-saffron-900 text-xs font-semibold border border-amber-300 active:scale-95 transition">
              <i data-lucide="sparkles" class="w-4 h-4 text-amber-600"></i>
              <span>दिव्य बैकग्राउंड</span>
            </button>
          </div>

          <div>
            <label class="block text-xs font-bold text-stone-700 mb-1">भगवान का नाम / हेडिंग:</label>
            <select id="creatorDeitySelect" onchange="updateCustomCanvas()" class="w-full text-xs p-2.5 bg-stone-50 border border-stone-200 rounded-xl focus:ring-2 focus:ring-saffron-500">
              <option value="॥ शुभ प्रभात ॥ जय श्री कृष्ण">॥ शुभ प्रभात ॥ जय श्री कृष्ण</option>
              <option value="॥ हर हर महादेव ॥ शुभ प्रभात">॥ हर हर महादेव ॥ शुभ प्रभात</option>
              <option value="॥ जय श्री राम ॥ मंगल प्रभात">॥ जय श्री राम ॥ मंगल प्रभात</option>
              <option value="॥ जय बजरंगबली ॥ संकटमोचन">॥ जय बजरंगबली ॥ संकटमोचन</option>
              <option value="॥ जय माता दी ॥ सुप्रभात">॥ जय माता दी ॥ सुप्रभात</option>
              <option value="॥ जय श्री गणेश ॥ शुभ प्रभात">॥ जय श्री गणेश ॥ शुभ प्रभात</option>
              <option value="॥ जय श्री श्याम ॥ हारे का सहारा">॥ जय श्री श्याम ॥ हारे का सहारा</option>
              <option value="॥ राधे राधे ॥ आपका दिन मंगलमय हो">॥ राधे राधे ॥ आपका दिन मंगलमय हो</option>
            </select>
          </div>

          <div>
            <label class="block text-xs font-bold text-stone-700 mb-1">सुविचार / भक्ति संदेश:</label>
            <textarea id="creatorSuvicharText" rows="2" oninput="updateCustomCanvas()" class="w-full text-xs p-2.5 bg-stone-50 border border-stone-200 rounded-xl focus:ring-2 focus:ring-saffron-500 resize-none">कर्म करो तो फल मिलता है, आज नहीं तो कल मिलता है। भगवान का स्मरण सदैव सुख व शांति देता है।</textarea>
          </div>

          <div class="grid grid-cols-2 gap-2">
            <div>
              <label class="block text-xs font-bold text-stone-700 mb-1">शुभचिंतक / आपका नाम:</label>
              <input type="text" id="creatorSenderName" value="प्रेषक: समस्त परिवार" oninput="updateCustomCanvas()" class="w-full text-xs p-2.5 bg-stone-50 border border-stone-200 rounded-xl focus:ring-2 focus:ring-saffron-500" />
            </div>
            <div>
              <label class="block text-xs font-bold text-stone-700 mb-1">फ्रेम का रंग:</label>
              <select id="creatorThemeSelect" onchange="updateCustomCanvas()" class="w-full text-xs p-2.5 bg-stone-50 border border-stone-200 rounded-xl focus:ring-2 focus:ring-saffron-500">
                <option value="gold">स्वर्ण (Divine Gold)</option>
                <option value="saffron">भगवा (Sacred Saffron)</option>
                <option value="maroon">मैरून (Royal Maroon)</option>
                <option value="peacock">मयूर नीला (Peacock Blue)</option>
              </select>
            </div>
          </div>

          <div class="pt-2 grid grid-cols-2 gap-2.5">
            <button onclick="downloadCustomCreatedStatus()" class="flex items-center justify-center gap-1.5 py-3 rounded-xl bg-stone-800 hover:bg-stone-900 text-white font-semibold text-xs shadow active:scale-95 transition">
              <i data-lucide="download" class="w-4 h-4"></i>
              <span>फोटो डाउनलोड करें</span>
            </button>

            <button onclick="shareCustomStatusToWhatsApp()" class="flex items-center justify-center gap-1.5 py-3 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-semibold text-xs shadow active:scale-95 transition">
              <i data-lucide="share-2" class="w-4 h-4"></i>
              <span>व्हाट्सएप पर शेयर</span>
            </button>
          </div>

        </div>
      </div>
    </section>

    <!-- VIEW 4: FESTIVALS & SPECIAL OCCASIONS -->
    <section id="view-festivals" class="hidden space-y-4">
      <div class="bg-gradient-to-r from-red-800 via-amber-800 to-saffron-800 text-white rounded-3xl p-4 shadow">
        <h2 class="text-lg font-bold flex items-center gap-2">
          <span>🪔</span> हिंदू पर्व एवं त्योहार विशेषांक
        </h2>
        <p class="text-xs text-amber-200 mt-1">सभी प्रमुख पर्वों की तिथियां, विशेष मंत्र और समर्पित स्टेटस संग्रह</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-3.5" id="festivalsContainer">
        <!-- Injected by JS -->
      </div>
    </section>

    <!-- VIEW 5: FAVORITES -->
    <section id="view-favorites" class="hidden space-y-4">
      <div class="bg-gradient-to-r from-rose-800 to-amber-800 text-white rounded-3xl p-4 shadow flex justify-between items-center">
        <div>
          <h2 class="text-lg font-bold flex items-center gap-2">
            <span>❤️</span> पसंदीदा स्टेटस संग्रह
          </h2>
          <p class="text-xs text-amber-200 mt-0.5">आपके द्वारा पसंद किए गए सभी स्टेटस</p>
        </div>
        <span class="text-xs px-2.5 py-1 bg-white/20 rounded-full font-bold font-mono" id="favCountBadge">0</span>
      </div>

      <div id="favoritesListGrid" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
        <!-- Injected by JS -->
      </div>
    </section>

  </main>

  <!-- ================= PHOTO PREVIEW MODAL ================= -->
  <div id="statusDetailModal" class="fixed inset-0 z-50 bg-black/80 backdrop-blur-sm hidden flex items-center justify-center p-3">
    <div class="bg-white rounded-3xl overflow-hidden max-w-sm w-full card-shadow flex flex-col max-h-[92vh]">
      
      <div class="px-4 py-3 bg-gradient-to-r from-saffron-800 to-amber-700 text-white flex items-center justify-between">
        <div class="flex items-center gap-2">
          <span class="text-xl">🪔</span>
          <div>
            <h4 class="font-bold text-sm leading-tight text-amber-50" id="modalDeityName">भगवान श्री कृष्ण</h4>
            <span class="text-[10px] text-amber-200" id="modalDateBadge">22 अक्टूबर 2026</span>
          </div>
        </div>
        <button onclick="closeStatusModal()" class="p-1 rounded-full text-white hover:bg-white/20 transition">
          <i data-lucide="x" class="w-5 h-5"></i>
        </button>
      </div>

      <div class="p-3 bg-stone-900 overflow-y-auto flex-1 flex flex-col items-center justify-center">
        <div class="relative w-full max-w-[320px] aspect-[4/5] rounded-2xl overflow-hidden shadow-lg border border-amber-300/40">
          <canvas id="modalRenderCanvas" width="1080" height="1350" class="w-full h-full object-contain"></canvas>
        </div>
      </div>

      <div class="p-3 bg-white border-t border-stone-200 space-y-2">
        <div class="grid grid-cols-3 gap-2">
          <button id="modalFavBtn" onclick="toggleModalFav()" class="flex flex-col items-center justify-center py-2 px-1 rounded-xl bg-rose-50 text-rose-700 border border-rose-200 text-[11px] font-semibold active:scale-95 transition">
            <i data-lucide="heart" class="w-4 h-4 mb-0.5"></i>
            <span id="modalFavText">पसंद करें</span>
          </button>
          
          <button onclick="downloadFromModal()" class="flex flex-col items-center justify-center py-2 px-1 rounded-xl bg-stone-800 text-white text-[11px] font-semibold active:scale-95 transition">
            <i data-lucide="download" class="w-4 h-4 mb-0.5"></i>
            <span>डाउनलोड</span>
          </button>

          <button onclick="shareFromModal()" class="flex flex-col items-center justify-center py-2 px-1 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-[11px] font-semibold active:scale-95 transition">
            <i data-lucide="share-2" class="w-4 h-4 mb-0.5"></i>
            <span>व्हाट्सएप</span>
          </button>
        </div>

