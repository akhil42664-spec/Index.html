    function drawStatusToCanvas(canvas, item, customSenderName = '', theme = 'gold') {
      if (!canvas) return;
      const ctx = canvas.getContext('2d');
      const w = canvas.width;
      const h = canvas.height;
      const dateInfo = getFormattedHindiDate(activeDate);

      ctx.clearRect(0, 0, w, h);
      ctx.fillStyle = '#1c1917';
      ctx.fillRect(0, 0, w, h);

      const themeColors = {
        gold: { border: '#F59E0B', inner: '#D97706', text: '#FEF3C7' },
        saffron: { border: '#EA580C', inner: '#C2410C', text: '#FFEDD5' },
        maroon: { border: '#991B1B', inner: '#7F1D1D', text: '#FEE2E2' },
        peacock: { border: '#0284C7', inner: '#0369A1', text: '#E0F2FE' }
      }[theme] || { border: '#F59E0B', inner: '#D97706', text: '#FEF3C7' };

      const renderDecorations = () => {
        const scrim = ctx.createLinearGradient(0, 0, 0, h);
        scrim.addColorStop(0, 'rgba(0,0,0,0.72)');
        scrim.addColorStop(0.28, 'rgba(0,0,0,0.18)');
        scrim.addColorStop(0.62, 'rgba(0,0,0,0.45)');
        scrim.addColorStop(1, 'rgba(0,0,0,0.96)');
        ctx.fillStyle = scrim;
        ctx.fillRect(0, 0, w, h);

        ctx.strokeStyle = themeColors.border;
        ctx.lineWidth = 14;
        ctx.strokeRect(32, 32, w - 64, h - 64);

        ctx.strokeStyle = themeColors.inner;
        ctx.lineWidth = 4;
        ctx.strokeRect(52, 52, w - 104, h - 104);

        [[54, 54], [w - 54, 54], [54, h - 54], [w - 54, h - 54]].forEach(([cx, cy]) => {
          ctx.beginPath();
          ctx.arc(cx, cy, 14, 0, Math.PI * 2);
          ctx.fillStyle = themeColors.border;
          ctx.fill();
        });

        ctx.textAlign = 'center';
        ctx.font = 'bold 46px "Noto Serif Devanagari", serif';
        ctx.fillStyle = themeColors.text;
        ctx.shadowColor = 'rgba(0, 0, 0, 0.9)';
        ctx.shadowBlur = 12;
        ctx.fillText(item.greeting || '॥ शुभ प्रभात ॥', w / 2, 125);

        ctx.font = '600 32px "Noto Serif Devanagari", serif';
        ctx.fillStyle = themeColors.border;
        ctx.fillText(item.deity || '॥ ॐ नमो भगवते वासुदेवाय ॥', w / 2, 178);

        ctx.font = 'bold 26px "Noto Serif Devanagari", sans-serif';
        const dateStr = `📅 ${dateInfo.fullText}`;
        const dateWidth = ctx.measureText(dateStr).width;
        ctx.fillStyle = 'rgba(69, 10, 10, 0.88)';
        ctx.beginPath();
        ctx.roundRect(w / 2 - dateWidth / 2 - 24, 206, dateWidth + 48, 46, 23);
        ctx.fill();
        ctx.strokeStyle = themeColors.border;
        ctx.lineWidth = 2;
        ctx.stroke();

        ctx.fillStyle = '#FEF3C7';
        ctx.fillText(dateStr, w / 2, 239);

        const quoteBoxY = h - 390;
        ctx.fillStyle = 'rgba(15, 12, 10, 0.86)';
        ctx.beginPath();
        ctx.roundRect(65, quoteBoxY, w - 130, 240, 26);
        ctx.fill();
        ctx.strokeStyle = themeColors.border;
        ctx.lineWidth = 3;
        ctx.stroke();

        ctx.font = '34px serif';
        ctx.fillText('🪷', w / 2, quoteBoxY + 42);

        ctx.font = '500 33px "Noto Serif Devanagari", serif';
        ctx.fillStyle = '#FFFFFF';
        wrapText(ctx, `"${item.quote}"`, w / 2, quoteBoxY + 95, w - 180, 46);

        ctx.font = '600 28px "Noto Serif Devanagari", sans-serif';
        ctx.fillStyle = themeColors.text;
        const sender = customSenderName.trim() || '॥ भक्ति स्टेटस – आपका दिन शुभ हो ॥';
        ctx.fillText(sender, w / 2, h - 85);
      };

      const img = new Image();
      img.crossOrigin = 'anonymous';
      img.onload = () => {
        const hRatio = w / img.width;
        const vRatio = h / img.height;
        const ratio = Math.max(hRatio, vRatio);
        const shiftX = (w - img.width * ratio) / 2;
        const shiftY = (h - img.height * ratio) / 2;
        ctx.drawImage(img, 0, 0, img.width, img.height, shiftX, shiftY, img.width * ratio, img.height * ratio);
        renderDecorations();
      };
      img.onerror = () => {
        const grad = ctx.createRadialGradient(w/2, h/2, 50, w/2, h/2, w/1.2);
        grad.addColorStop(0, '#c2410c');
        grad.addColorStop(1, '#450a0a');
        ctx.fillStyle = grad;
        ctx.fillRect(0, 0, w, h);
        renderDecorations();
      };
      img.src = item.image;
    }

    function wrapText(context, text, x, y, maxWidth, lineHeight) {
      const words = text.split(' ');
      let line = '';
      for (let n = 0; n < words.length; n++) {
        const testLine = line + words[n] + ' ';
        if (context.measureText(testLine).width > maxWidth && n > 0) {
          context.fillText(line, x, y);
          line = words[n] + ' ';
          y += lineHeight;
        } else {
          line = testLine;
        }
      }
      context.fillText(line, x, y);
    }

